# imaging data and nnU-Net working directories — never commit patient data
data/nnUNet_raw/**
data/nnUNet_preprocessed/**
data/nnUNet_results/**
!data/nnUNet_raw/.gitkeep
!data/nnUNet_preprocessed/.gitkeep
!data/nnUNet_results/.gitkeep

# raw DICOM exports (may contain extension-less files like DICOMDIR) and all derived per-case outputs
data/dicom_raw/**
!data/dicom_raw/.gitkeep
data/inference_input/
data/inference_staging/
data/predictions_full/
data/predictions_right_heart/

# large model weights / checkpoints
*.pth
*.pt
*.ckpt
*.npz
*.npy

# common imaging formats — keep code, not data, in this repo
*.nii
*.nii.gz
*.dcm
*.mha
*.mhd
*.raw
*.stl
*.vtk
*.vtp

# python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
